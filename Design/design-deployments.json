{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "filter-reading"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "filter-reading"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "filter-reading"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "filter-reading",
                "image": "northamerica-northeast2-docker.pkg.dev/sofe4630u-ms1-509300/sofe4630u/filter-reading:v1",
                "env": [
                  {
                    "name": "GCP_PROJECT",
                    "value": "sofe4630u-ms1-509300"
                  },
                  {
                    "name": "TOPIC_NAME",
                    "value": "smartMeterMS4"
                  },
                  {
                    "name": "SUBSCRIPTION_ID",
                    "value": "ms4-filter-sub"
                  },
                  {
                    "name": "GOOGLE_APPLICATION_CREDENTIALS",
                    "value": "/var/secrets/google/credentials.json"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "512Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "credentials",
                    "mountPath": "/var/secrets/google",
                    "readOnly": true
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "credentials",
                "secret": {
                  "secretName": "voting-credentials"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "convert-reading"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "convert-reading"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "convert-reading"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "convert-reading",
                "image": "northamerica-northeast2-docker.pkg.dev/sofe4630u-ms1-509300/sofe4630u/convert-reading:v1",
                "env": [
                  {
                    "name": "GCP_PROJECT",
                    "value": "sofe4630u-ms1-509300"
                  },
                  {
                    "name": "TOPIC_NAME",
                    "value": "smartMeterMS4"
                  },
                  {
                    "name": "SUBSCRIPTION_ID",
                    "value": "ms4-convert-sub"
                  },
                  {
                    "name": "GOOGLE_APPLICATION_CREDENTIALS",
                    "value": "/var/secrets/google/credentials.json"
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "512Mi"
                  }
                },
                "volumeMounts": [
                  {
                    "name": "credentials",
                    "mountPath": "/var/secrets/google",
                    "readOnly": true
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "credentials",
                "secret": {
                  "secretName": "voting-credentials"
                }
              }
            ]
          }
        }
      }
    }
  ]
}